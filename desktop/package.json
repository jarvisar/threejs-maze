{
  "name": "backrooms-simulator-desktop",
  "productName": "Backrooms Simulator",
  "version": "2.0.0",
  "private": true,
  "description": "Desktop app for Backrooms Simulator: the web build in an Electron window.",
  "author": "Jarvisar",
  "homepage": "https://github.com/jarvisar/threejs-maze",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs --dev",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
