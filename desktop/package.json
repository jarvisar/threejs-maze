{
  "name": "backrooms-simulator-desktop",
  "productName": "Backrooms Simulator",
  "version": "2.0.0",
  "private": true,
  "description": "Desktop app for Backrooms Simulator: the web build in an Electron window.",
  "author": "Jarvisar",
  "homepage": "https://github.com/jarvisar/threejs-maze",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs --dev",
    "test": "node ../node_modules/vitest/vitest.mjs run --config vitest.config.js",
    "pack": "node scripts/package.mjs --dir",
    "dist": "node scripts/package.mjs",
    "dist:win": "node scripts/package.mjs --win",
    "dist:linux": "node scripts/package.mjs --linux",
    "dist:mac": "node scripts/package.mjs --mac"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "js-yaml": "4.3.2"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
